# Скопируйте в .env рядом с pulsenet и поправьте. Переменные окружения имеют приоритет над файлом.
# Пути без пробелов: LLAMACPP_EXTRA_ARGS режется по пробелам.

# --- LLM: llamacpp (llama-server) или lmstudio (LM Studio) ---
LLM_BACKEND=llamacpp
MODELS_DIR=E:\models
LLAMACPP_SERVER_BIN=C:\llama.cpp\llama-server.exe
LLAMACPP_PORT=8090
LLAMACPP_DEFAULT_MODEL=lmstudio-community/Qwen3.5-9B-GGUF/Qwen3.5-9B-Q8_0.gguf
LLAMACPP_AUTOSTART=1
LLAMACPP_CUDA_DEVICE_ORDER=PCI_BUS_ID
# LoRA-адаптер «Сна» (пока пусто): LLAMACPP_EXTRA_ARGS=--lora-scaled E:\models\lora\triplex-sleep.gguf 0.5
# LLAMACPP_EXTRA_ARGS=

# LM Studio (LLM_BACKEND=lmstudio)
# LMSTUDIO_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=имя-модели

# --- сервер ---
# 127.0.0.1 — без nginx; 0.0.0.0 — если nginx в Docker (закройте порт в брандмауэре для внешних адресов)
PULSENET_HOST=127.0.0.1
PULSENET_PORT=8000

# --- MCP (внешние ИИ). Без токена /mcp отключён ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSENET_MCP_TOKEN=
PULSENET_MCP_HOSTS=localhost

# --- память ТРИПЛЕКСИЯ ---
TRIPLEX_MEMORY=1
TRIPLEX_EXTRACT=1
# Ваше имя: «я» в ваших репликах запишется как это имя
TRIPLEX_USER_NAME=
# Порог релевантности (0.35 — для офлайн-эмбеддера; с bge-m3 подберите по данным)
TRIPLEX_MIN_COS=0.35
# --- эмбеддер: достаточно одного из вариантов. Модель и размерность определяются сами ---
# Вариант 1 (рекомендуется): модель эмбеддингов загружена в LM Studio (любая: bge-m3, nomic, e5).
# Загрузите её в LM Studio и оставьте загруженной; если она там одна — имя можно не указывать.
# GGUF, лежащий прямо в папке моделей, LM Studio может не увидеть — импортируйте его:
#   lms import -L "E:\models\model.gguf" -y
TRIPLEX_EMBED_URL=http://localhost:1234/v1
#
# Вариант 2: отдельный процесс llama-server из GGUF (грузится один раз при старте приложения).
# Раскомментируйте путь и поставьте, например, bge-m3-f16.gguf или nomic-embed-text-v1.5.Q4_K_M.gguf:
# TRIPLEX_EMBED_MODEL_PATH=E:\models\embed\bge-m3-f16.gguf
# TRIPLEX_EMBED_PORT=8091
# TRIPLEX_EMBED_POOLING=cls
#   (для nomic: TRIPLEX_EMBED_POOLING=mean)
#
# Если в LM Studio несколько моделей эмбеддингов, укажите нужную явно:
# TRIPLEX_EMBED_MODEL=text-embedding-bge-m3
# TRIPLEX_EMBED_DIM=1024
#
# Префиксы задач подбираются по имени модели (nomic, e5). Переопределить:
# TRIPLEX_EMBED_DOC_PREFIX=
# TRIPLEX_EMBED_QUERY_PREFIX=
# Экстракция идёт через бэкенд чата; переопределить адрес:
# TRIPLEX_LLM_URL=http://127.0.0.1:8080/v1
# TRIPLEX_LLM_MODEL=local

# --- поиск: SearXNG в Docker (см. searxng/) ---
# run_server.bat поднимает контейнер; если Docker недоступен, поиск идёт через DuckDuckGo.
SEARXNG_URL=http://127.0.0.1:8080
SEARCH_BACKENDS_ORDER=searxng,ddg
SEARCH_TIME_BUDGET=15

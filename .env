# Бэкенд: llamacpp (GGUF напрямую) или lmstudio (сервер LM Studio)
BRAIN_LM_BACKEND=llamacpp
BRAIN_LM_VERBOSE=1
# Путь к модели: одинарные обратные слэши, без кавычек
BRAIN_LM_PATH=E:\models\lmstudio-community\Qwen3.5-9B-GGUF\Qwen3.5-9B-Q8_0.gguf

# GPU: -1 — все слои на видеокарту; если не хватает памяти, например 20
BRAIN_LM_GPU_LAYERS=-1
BRAIN_LM_CTX=4096
BRAIN_LM_THREADS=8
# Генерация
BRAIN_LM_MAX_TOKENS=220
BRAIN_LM_TEMPERATURE=0.7
BRAIN_LM_TOP_P=0.9
BRAIN_LM_HISTORY=3
BRAIN_LM_TIMEOUT=180

# Для LM Studio (если BRAIN_LM_BACKEND=lmstudio)
BRAIN_LM_URL=http://localhost:1234/v1/chat/completions
BRAIN_LM_NAME=qwen3.5-9b
# Скопируйте в файл .env рядом с pulsenet и поправьте под себя.
# Переменные из окружения имеют приоритет над этим файлом.

# Выбор бэкенда: llamacpp (llama-server) или lmstudio (LM Studio)
LLM_BACKEND=llamacpp

# --- llama-server ---
MODELS_DIR=E:\models
LLAMACPP_SERVER_BIN=C:\llama.cpp\llama-server.exe
LLAMACPP_PORT=8090
LLAMACPP_DEFAULT_MODEL=lmstudio-community/Qwen3.5-9B-GGUF/Qwen3.5-9B-Q8_0.gguf
LLAMACPP_AUTOSTART=1
LLAMACPP_CUDA_DEVICE_ORDER=PCI_BUS_ID
# дополнительные аргументы llama-server (необязательно), например: --reasoning-budget 0
# LLAMACPP_EXTRA_ARGS=

# --- LM Studio (когда LLM_BACKEND=lmstudio) ---
# LMSTUDIO_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=имя-модели-в-lm-studio

# --- сервер pulsenet ---
PULSENET_HOST=127.0.0.1
PULSENET_PORT=8000

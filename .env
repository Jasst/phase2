# ╨б╨║╨╛╨┐╨╕╤А╤Г╨╣╤В╨╡ ╨▓ .env ╤А╤П╨┤╨╛╨╝ ╤Б pulsenet ╨╕ ╨┐╨╛╨┐╤А╨░╨▓╤М╤В╨╡. ╨Я╨╡╤А╨╡╨╝╨╡╨╜╨╜╤Л╨╡ ╨╛╨║╤А╤Г╨╢╨╡╨╜╨╕╤П ╨╕╨╝╨╡╤О╤В ╨┐╤А╨╕╨╛╤А╨╕╤В╨╡╤В ╨╜╨░╨┤ ╤Д╨░╨╣╨╗╨╛╨╝.
# ╨Я╤Г╤В╨╕ ╨▒╨╡╨╖ ╨┐╤А╨╛╨▒╨╡╨╗╨╛╨▓: LLAMACPP_EXTRA_ARGS ╤А╨╡╨╢╨╡╤В╤Б╤П ╨┐╨╛ ╨┐╤А╨╛╨▒╨╡╨╗╨░╨╝.

# --- LLM: llamacpp (llama-server) ╨╕╨╗╨╕ lmstudio (LM Studio) ---
LLM_BACKEND=lmstudio

MODELS_DIR=E:\models
#LLAMACPP_SERVER_BIN=C:\llama.cpp\llama-server.exe
#LLAMACPP_PORT=8090
#LLAMACPP_DEFAULT_MODEL=lmstudio-community/google/gemma-4-26b-a4b-qat
#LLAMACPP_AUTOSTART=1
#LLAMACPP_CUDA_DEVICE_ORDER=PCI_BUS_ID
# LoRA-╨░╨┤╨░╨┐╤В╨╡╤А ┬л╨б╨╜╨░┬╗ (╨┐╨╛╨║╨░ ╨┐╤Г╤Б╤В╨╛): LLAMACPP_EXTRA_ARGS=--lora-scaled E:\models\lora\triplex-sleep.gguf 0.5
# LLAMACPP_EXTRA_ARGS=

# LM Studio (LLM_BACKEND=lmstudio)
LMSTUDIO_URL=http://localhost:1234/v1
#LMSTUDIO_MODEL=qwen/qwen3.5-9b

# --- ╤Б╨╡╤А╨▓╨╡╤А ---
# 127.0.0.1 тАФ ╨▒╨╡╨╖ nginx; 0.0.0.0 тАФ ╨╡╤Б╨╗╨╕ nginx ╨▓ Docker (╨╖╨░╨║╤А╨╛╨╣╤В╨╡ ╨┐╨╛╤А╤В ╨▓ ╨▒╤А╨░╨╜╨┤╨╝╨░╤Г╤Н╤А╨╡ ╨┤╨╗╤П ╨▓╨╜╨╡╤И╨╜╨╕╤Е ╨░╨┤╤А╨╡╤Б╨╛╨▓)
PULSENET_HOST=127.0.0.1
PULSENET_PORT=8000

# --- MCP (╨▓╨╜╨╡╤И╨╜╨╕╨╡ ╨Ш╨Ш). ╨С╨╡╨╖ ╤В╨╛╨║╨╡╨╜╨░ /mcp ╨╛╤В╨║╨╗╤О╤З╤С╨╜ ---
# ╨б╨│╨╡╨╜╨╡╤А╨╕╤А╨╛╨▓╨░╤В╤М: python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSENET_MCP_TOKEN=XoOkZKR3NBc0R9zP0p66e0HrQlPAek6UgZ3ok84p-2Q
PULSENET_MCP_HOSTS=localhost,blockcoin.ru,www.blockcoin.ru,blockchat.ru,www.blockchat.ru

# --- ╨┐╨░╨╝╤П╤В╤М ╨в╨а╨Ш╨Я╨Ы╨Х╨Ъ╨б╨Ш╨п ---
TRIPLEX_MEMORY=1
TRIPLEX_EXTRACT=1
# ╨Т╨░╤И╨╡ ╨╕╨╝╤П: ┬л╤П┬╗ ╨▓ ╨▓╨░╤И╨╕╤Е ╤А╨╡╨┐╨╗╨╕╨║╨░╤Е ╨╖╨░╨┐╨╕╤И╨╡╤В╤Б╤П ╨║╨░╨║ ╤Н╤В╨╛ ╨╕╨╝╤П
TRIPLEX_USER_NAME=
# ╨Я╨╛╤А╨╛╨│ ╤А╨╡╨╗╨╡╨▓╨░╨╜╤В╨╜╨╛╤Б╤В╨╕ (0.35 тАФ ╨┤╨╗╤П ╨╛╤Д╨╗╨░╨╣╨╜-╤Н╨╝╨▒╨╡╨┤╨┤╨╡╤А╨░; ╤Б bge-m3 ╨┐╨╛╨┤╨▒╨╡╤А╨╕╤В╨╡ ╨┐╨╛ ╨┤╨░╨╜╨╜╤Л╨╝)
TRIPLEX_MIN_COS=0.35
# --- ╤Н╨╝╨▒╨╡╨┤╨┤╨╡╤А: ╨┤╨╛╤Б╤В╨░╤В╨╛╤З╨╜╨╛ ╨╛╨┤╨╜╨╛╨│╨╛ ╨╕╨╖ ╨▓╨░╤А╨╕╨░╨╜╤В╨╛╨▓. ╨Ь╨╛╨┤╨╡╨╗╤М ╨╕ ╤А╨░╨╖╨╝╨╡╤А╨╜╨╛╤Б╤В╤М ╨╛╨┐╤А╨╡╨┤╨╡╨╗╤П╤О╤В╤Б╤П ╤Б╨░╨╝╨╕ ---
# ╨Т╨░╤А╨╕╨░╨╜╤В 1 (╤А╨╡╨║╨╛╨╝╨╡╨╜╨┤╤Г╨╡╤В╤Б╤П): ╨╝╨╛╨┤╨╡╨╗╤М ╤Н╨╝╨▒╨╡╨┤╨┤╨╕╨╜╨│╨╛╨▓ ╨╖╨░╨│╤А╤Г╨╢╨╡╨╜╨░ ╨▓ LM Studio (╨╗╤О╨▒╨░╤П: bge-m3, nomic, e5).
# ╨Ч╨░╨│╤А╤Г╨╖╨╕╤В╨╡ ╨╡╤С ╨▓ LM Studio ╨╕ ╨╛╤Б╤В╨░╨▓╤М╤В╨╡ ╨╖╨░╨│╤А╤Г╨╢╨╡╨╜╨╜╨╛╨╣; ╨╡╤Б╨╗╨╕ ╨╛╨╜╨░ ╤В╨░╨╝ ╨╛╨┤╨╜╨░ тАФ ╨╕╨╝╤П ╨╝╨╛╨╢╨╜╨╛ ╨╜╨╡ ╤Г╨║╨░╨╖╤Л╨▓╨░╤В╤М.
TRIPLEX_EMBED_URL=http://localhost:1234/v1
#
# ╨Т╨░╤А╨╕╨░╨╜╤В 2: ╨╛╤В╨┤╨╡╨╗╤М╨╜╤Л╨╣ ╨┐╤А╨╛╤Ж╨╡╤Б╤Б llama-server ╨╕╨╖ GGUF (╨│╤А╤Г╨╖╨╕╤В╤Б╤П ╨╛╨┤╨╕╨╜ ╤А╨░╨╖ ╨┐╤А╨╕ ╤Б╤В╨░╤А╤В╨╡ ╨┐╤А╨╕╨╗╨╛╨╢╨╡╨╜╨╕╤П).
# ╨а╨░╤Б╨║╨╛╨╝╨╝╨╡╨╜╤В╨╕╤А╤Г╨╣╤В╨╡ ╨┐╤Г╤В╤М ╨╕ ╨┐╨╛╤Б╤В╨░╨▓╤М╤В╨╡, ╨╜╨░╨┐╤А╨╕╨╝╨╡╤А, bge-m3-f16.gguf ╨╕╨╗╨╕ nomic-embed-text-v1.5.Q4_K_M.gguf:
# TRIPLEX_EMBED_MODEL_PATH=E:\models\embed\bge-m3-f16.gguf
# TRIPLEX_EMBED_PORT=8091
# TRIPLEX_EMBED_POOLING=cls
#   (╨┤╨╗╤П nomic: TRIPLEX_EMBED_POOLING=mean)
#
# ╨Х╤Б╨╗╨╕ ╨▓ LM Studio ╨╜╨╡╤Б╨║╨╛╨╗╤М╨║╨╛ ╨╝╨╛╨┤╨╡╨╗╨╡╨╣ ╤Н╨╝╨▒╨╡╨┤╨┤╨╕╨╜╨│╨╛╨▓, ╤Г╨║╨░╨╢╨╕╤В╨╡ ╨╜╤Г╨╢╨╜╤Г╤О ╤П╨▓╨╜╨╛
# (╨╕╨╜╨░╤З╨╡ ╨▒╨╡╤А╤С╤В╤Б╤П ╨┐╨╡╤А╨▓╨░╤П ╨┐╨╛╨┤╤Е╨╛╨┤╤П╤Й╨░╤П ╨╕╨╖ /v1/models):
TRIPLEX_EMBED_MODEL=text-embedding-bge-m3
# TRIPLEX_EMBED_DIM=1024
#
# ╨Я╤А╨╡╤Д╨╕╨║╤Б╤Л ╨╖╨░╨┤╨░╤З ╨┐╨╛╨┤╨▒╨╕╤А╨░╤О╤В╤Б╤П ╨┐╨╛ ╨╕╨╝╨╡╨╜╨╕ ╨╝╨╛╨┤╨╡╨╗╨╕ (nomic, e5). ╨Я╨╡╤А╨╡╨╛╨┐╤А╨╡╨┤╨╡╨╗╨╕╤В╤М:
# TRIPLEX_EMBED_DOC_PREFIX=
# TRIPLEX_EMBED_QUERY_PREFIX=
# ╨н╨║╤Б╤В╤А╨░╨║╤Ж╨╕╤П ╨╕╨┤╤С╤В ╤З╨╡╤А╨╡╨╖ ╨▒╤Н╨║╨╡╨╜╨┤ ╤З╨░╤В╨░; ╨┐╨╡╤А╨╡╨╛╨┐╤А╨╡╨┤╨╡╨╗╨╕╤В╤М ╨░╨┤╤А╨╡╤Б:
# TRIPLEX_LLM_URL=http://127.0.0.1:8080/v1
# TRIPLEX_LLM_MODEL=local

# --- ╨┐╨╛╨╕╤Б╨║: SearXNG ╨▓ Docker (╤Б╨╝. searxng/) ---
# run_server.bat ╨┐╨╛╨┤╨╜╨╕╨╝╨░╨╡╤В ╨║╨╛╨╜╤В╨╡╨╣╨╜╨╡╤А; ╨╡╤Б╨╗╨╕ Docker ╨╜╨╡╨┤╨╛╤Б╤В╤Г╨┐╨╡╨╜, ╨┐╨╛╨╕╤Б╨║ ╨╕╨┤╤С╤В ╤З╨╡╤А╨╡╨╖ DuckDuckGo.
SEARXNG_URL=http://127.0.0.1:8080
SEARCH_BACKENDS_ORDER=searxng,ddg
SEARCH_TIME_BUDGET=15


# --- Доступ к MCP извне (через nginx: https://www.blockchat.ru/mcp) ---
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,blockchat.ru,blockchat.ru:*,www.blockchat.ru,www.blockchat.ru:*,blockcoin.ru,blockcoin.ru:*,www.blockcoin.ru,www.blockcoin.ru:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,https://127.0.0.1,https://127.0.0.1:*,https://localhost,https://localhost:*,https://blockchat.ru,https://blockchat.ru:*,https://www.blockchat.ru,https://www.blockchat.ru:*,https://blockcoin.ru,https://blockcoin.ru:*,https://www.blockcoin.ru,https://www.blockcoin.ru:*
